# FileName=unbound.container
[Unit]
Description=Unbound DNS Container
After=network-online.target
Wants=network-online.target

[Container]
Image=ghcr.io/johnlevandowski/unbound:latest
HostName=unbound

Network=pasta:--ipv4-only
PublishPort=5335:5335/tcp
PublishPort=5335:5335/udp

HealthCmd=dig -p 5335 @127.0.0.1 www.google.com +short || exit 1
HealthInterval=30s
HealthRetries=3
HealthStartPeriod=10s
HealthTimeout=30s

# Volume=./etc-unbound:/etc/unbound/unbound.conf.d/

[Service]
Restart=always

[Install]
WantedBy=default.target
